{
  "name": "@local/dsh-autoloop-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "铁卡老弟：autoloop 中控台 DSH 插件——看全局、审批卡片、查轮次与花费（Host 同源代理 + Client 面板）。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "meta": {
    "title": "铁卡老弟",
    "description": "铁卡老弟：autoloop 中控台——看全局、审批卡片、查轮次与花费。"
  },
  "license": "MIT"
}
